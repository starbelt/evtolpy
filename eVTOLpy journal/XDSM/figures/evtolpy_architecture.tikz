\begin{pgfonlayer}{background}
\node[draw, dashed, fill=white, inner sep=15pt, fit=(env) (aero) (prop) (power), xshift=5pt, yshift=-5pt] (mission_box_2) {};
\node[draw, dashed, fill=white, inner sep=15pt, fit=(env) (aero) (prop) (power)] (mission_box_1) {};
\node[anchor=center, fill=white, inner sep=4pt, font=\small] at (mission_box_1.north) {Mission};
\node[anchor=west, inner sep=4pt, font=\small] at (mission_box_2.east) {\# segments};
\end{pgfonlayer}


% XDSM process chains


\begin{pgfonlayer}{data}
\path
% Horizontal edges
(mass_sizing) edge [DataLine] (mass_sizing-mass)
(geom) edge [DataLine] (geom-mass)
(mass) edge [DataLine] (mass-env)
(mass) edge [DataLine] (mass-togw)
(env) edge [DataLine] (env-aero)
(env) edge [DataLine] (env-prop)
(env) edge [DataLine] (env-power)
(aero) edge [DataLine] (aero-prop)
(aero) edge [DataLine] (aero-power)
(prop) edge [DataLine] (prop-power)
(mission_box_2.east |- power-bat_siz) edge [DataLine] (power-bat_siz)
(bat_siz) edge [DataLine] (bat_siz-togw)
(togw) edge [DataLine] (togw-mass_sizing)
% Vertical edges
(mass_sizing-mass) edge [DataLine] (mass)
(geom-mass) edge [DataLine] (mass)
(mass-env) edge [DataLine] (mass-env |- mission_box_1.north)
(mass-togw) edge [DataLine] (togw)
(env-aero) edge [DataLine] (aero)
(env-prop) edge [DataLine] (prop)
(env-power) edge [DataLine] (power)
(aero-prop) edge [DataLine] (prop)
(aero-power) edge [DataLine] (power)
(prop-power) edge [DataLine] (power)
(power-bat_siz) edge [DataLine] (bat_siz)
(bat_siz-togw) edge [DataLine] (togw)
(togw-mass_sizing) edge [DataLine] (mass_sizing)
(mass_sizing) edge [DataLine] (output_mass_sizing)
(geom) edge [DataLine] (output_geom)
(output_env |- mission_box_1.north) edge [DataLine] (output_env);
\end{pgfonlayer}

\end{tikzpicture}
